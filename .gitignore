# Python
__pycache__/
*.pyc

# Node / Next.js (web dashboard)
web/node_modules/
web/.next/
web/out/

# Bulky regenerable artifacts — the raw source archive stays local only
data/raw/
data/review_export.xlsx

# Local tooling
.claude/

# Database — 38MB binary, rebuilt by the scraper pipeline (see README)
data/*.db
data/*.sqlite3
# NOTE: web/public/data.json stays tracked on purpose — Vercel builds the
# public dashboard from it, so untracking it would break the deploy.

# Secrets — never version
.env
.env.*
*.pem
*.key
